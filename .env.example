# Copy to your environment (do not commit real values).
# Flask session signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
IDL_SECRET_KEY=

# Admin bootstrap (used by scripts/create_admin.py)
IDL_ADMIN_USERNAME=
IDL_ADMIN_PASSWORD=

# Server
IDL_HOST=0.0.0.0
IDL_PORT=8000

# Set to 1 when serving over HTTPS so session cookies get the Secure flag
IDL_SECURE_COOKIES=0

# Optional storage overrides (defaults: ./data and ./storage)
# IDL_DATA_DIR=
# IDL_STORAGE_DIR=
# IDL_DB_PATH=
